#!/usr/bin/env python3
"""attribution-check — every agent-authored commit in a range names its harness, model and initiator.

  attribution-check <base>..<head>

Agents commit under the human's git identity, so the author field cannot tell an agent commit from a
human one; the trailers are the only record of which harness and model wrote a change and who asked
for it. A rule that lives in a skill is lost when a session's context is compacted, and the harness's
own attribution reminder names only `Co-Authored-By`, so commits kept shipping with that line alone.
This is the gate that does not depend on anyone remembering.

A non-merge commit in the range is:
  ATTRIBUTED    it carries `Harness:`, `Model:` and `Initiated-By:`                    → pass
  INCOMPLETE    it carries ANY agent signal — a `Co-Authored-By:` naming an AI model, or  → FAIL
                any one of the three — but not all three
  UNATTRIBUTED  it carries none of them: read as a human's commit, and listed so a        → notice
                human can see it; an agent commit that dropped EVERY trailer lands here too

A trailer may sit anywhere in the message, on its own line or after a ` · ` separator: agents write
them as a block before `Co-Authored-By:`, which `git interpret-trailers` would not see as trailers.

Exit: 0 no INCOMPLETE commit · 1 at least one · 2 cannot check (bad range, git error, or ZERO non-merge
commits in the range: an empty range is a broken fetch far more often than an empty change, and a check
that looked at nothing is never reported clean).
"""
import re
import subprocess
import sys

REQUIRED = ("Harness", "Model", "Initiated-By")
AI_COAUTHOR = re.compile(r"^Co-Authored-By:.*\b(claude|anthropic|codex|openai|gpt|grok|xai)\b",
                         re.IGNORECASE | re.MULTILINE)


def has(key, body):
    return re.search(rf"(^|·\s*){re.escape(key)}:[ \t]*\S", body, re.MULTILINE) is not None


def main(argv):
    if len(argv) != 2 or ".." not in argv[1]:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2
    try:
        out = subprocess.run(["git", "log", "--no-merges", "--format=%H%x00%s%x00%B%x1e", argv[1]],
                             capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        print(f"attribution-check: cannot read the range {argv[1]!r}: {getattr(e, 'stderr', e)}".strip(),
              file=sys.stderr)
        return 2
    commits = [r.strip("\n").split("\x00", 2) for r in out.split("\x1e") if r.strip()]
    if not commits:
        print(f"attribution-check: 0 non-merge commits in {argv[1]} — nothing was checked, which is "
              "not a pass (a shallow fetch produces exactly this)", file=sys.stderr)
        return 2
    incomplete = 0
    for sha, subject, body in commits:
        present = [k for k in REQUIRED if has(k, body)]
        if len(present) == len(REQUIRED):
            continue
        if present or AI_COAUTHOR.search(body):
            missing = ", ".join(f"{k}:" for k in REQUIRED if k not in present)
            print(f"INCOMPLETE    {sha[:10]}  {subject}\n              lacks {missing}")
            incomplete += 1
        else:
            print(f"UNATTRIBUTED  {sha[:10]}  {subject}  (no agent trailers; read as a human commit)")
    print(f"attribution-check: {len(commits)} commit(s), {incomplete} incomplete")
    return 1 if incomplete else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
