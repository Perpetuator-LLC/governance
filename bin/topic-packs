#!/usr/bin/env python3
"""topic-packs — build small per-topic rule packs from the CORE, for tools that serve guidance on demand.

  topic-packs [--root DIR]            write packs/ from packs/topics.json
  topic-packs [--root DIR] --check    rebuild in memory; fail on any drift from the committed packs/

A client that loads guidance through a tool (an MCP-only user, a sandboxed agent with no rendered
instruction files) cannot afford the whole core in its context. So each topic is a short pack of rule
statements, and a rule's full text is a second, bounded fetch. Every answer is a static file:

  packs/index.json          the topic list                         <= CAP_INDEX bytes
  packs/<topic>.md          each rule's heading + lead paragraph   <= CAP_PACK bytes (a lead over
                                                                      CAP_LEAD is cut at a sentence
                                                                      and marked […])
  packs/rules/<slug>.md     one rule's whole section               <= CAP_RULE bytes, cut at a
                                                                      paragraph boundary, marked

The manifest packs/topics.json lists, per topic, a name, a title, a one-line `when`, and rules as
"<file> § <exact ## heading>" in the order a reader needs them. Picking rules for a task is judgement,
so the manifest is curated by hand; copying their text is not, so the packs are generated.

Inputs are fixed: packs/topics.json names `<file> § <heading>` pairs, and every file must sit under
core/. Nothing outside core/ is ever read, so an organisation's private layer cannot reach a pack by
construction rather than by a filter.

Fails (exit 1), never truncates silently: a pack or the index over its cap, a heading that no longer
exists, a source outside core/, a duplicate rule slug. --check also fails when packs/ differs from what
the manifest builds (edit the manifest or core, then rerun without --check).
"""
import argparse, json, os, re, sys

CAP_PACK, CAP_INDEX, CAP_RULE, CAP_LEAD = 4096, 1024, 8192, 700
MORE = " […]"
HEADER = "<!-- generated by bin/topic-packs from packs/topics.json from core/ only; do not edit -->\n"
TRUNC = "\n\n[truncated: this rule continues in the core source]\n"


class Fail(Exception):
    pass


def slug(heading):
    s = re.sub(r"[^a-z0-9]+", "-", heading.lower()).strip("-")
    return s[:60].rstrip("-")


def sections(path):
    """{heading: (lead, full)} for every '## ' section of a Markdown file."""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    out = {}
    for part in re.split(r"(?m)^## ", text)[1:]:
        heading, _, body = part.partition("\n")
        body = re.split(r"(?m)^## ", body)[0].strip("\n")
        paras = [p for p in re.split(r"\n\s*\n", body.strip()) if p.strip()]
        lead = paras[0].strip() if paras else ""
        out[heading.strip()] = (lead, "## " + heading.strip() + "\n\n" + body.strip() + "\n")
    return out


def cap_lead(lead):
    """A lead longer than CAP_LEAD is cut at the last sentence end that fits and marked […]: the
    pack points at the rule, and the full text is one rule fetch away."""
    if len(lead.encode()) <= CAP_LEAD:
        return lead
    cut = lead.encode()[:CAP_LEAD - len(MORE.encode())].decode("utf-8", "ignore")
    ends = [m.end() for m in re.finditer(r"[.!?][*_)\]]*(?=\s)", cut)]
    return (cut[:ends[-1]] if ends else cut.rsplit(" ", 1)[0]).rstrip() + MORE


def cap_rule(full, prefix):
    """The whole file, prefix included, stays within CAP_RULE."""
    budget = CAP_RULE - len(prefix.encode())
    if len(full.encode()) <= budget:
        return prefix + full
    keep, size = [], len(TRUNC.encode())
    for p in re.split(r"(\n\s*\n)", full):
        if size + len(p.encode()) > budget:
            break
        keep.append(p); size += len(p.encode())
    return prefix + "".join(keep).rstrip() + TRUNC


def load_manifest(root):
    with open(os.path.join(root, "packs", "topics.json"), encoding="utf-8") as fh:
        m = json.load(fh)
    if not isinstance(m, dict) or m.get("version") != 1 or not isinstance(m.get("topics"), list):
        raise Fail("packs/topics.json: need version: 1 and a topics list")
    return m


def build(root):
    """{relative path: content} for everything under packs/ except topics.json."""
    m = load_manifest(root)
    corer = os.path.realpath(os.path.join(root, "core"))
    cache, files, index, seen = {}, {}, [], {}
    for t in m["topics"]:
        name, title, when = t.get("name"), t.get("title"), t.get("when")
        if not (name and title and when and re.fullmatch(r"[a-z][a-z0-9-]*", name) and t.get("rules")):
            raise Fail(f"topic {name!r}: needs name ([a-z0-9-]), title, when and rules")
        lines = [HEADER, f"# {title}\n", f"{when}\n"]
        for ref in t["rules"]:
            if not isinstance(ref, str):
                raise Fail(f"{name}: rule {ref!r} is not a string")
            src, sep, heading = ref.partition(" § ")
            if not sep:
                raise Fail(f"{name}: {ref!r} is not '<file> § <heading>'")
            path = os.path.realpath(os.path.join(root, src))
            if not path.startswith(corer + os.sep):
                raise Fail(f"{name}: {src} is outside core/; packs are built from the core only")
            if path not in cache:
                if not os.path.isfile(path):
                    raise Fail(f"{name}: no such file {src}")
                cache[path] = sections(path)
            if heading not in cache[path]:
                raise Fail(f"{name}: no '## {heading}' in {src} (renamed or removed?)")
            lead, full = cache[path][heading]
            s = slug(heading)
            if s in seen and seen[s] != (src, heading):
                raise Fail(f"slug {s!r} names two rules: {seen[s]} and {(src, heading)}")
            seen[s] = (src, heading)
            lines.append(f"\n## {heading}\n\n{cap_lead(lead)}\n\nrule: {s}\n")
            files[f"rules/{s}.md"] = cap_rule(full, HEADER + f"source: {src}\n\n")
        pack = "".join(lines)
        size = len(pack.encode())
        if size > CAP_PACK:
            raise Fail(f"pack {name} is {size} B, over {CAP_PACK}: trim its rule list in packs/topics.json")
        files[f"{name}.md"] = pack
        index.append({"topic": name, "when": when, "bytes": size})
    idx = json.dumps({"version": 1, "topics": index}, ensure_ascii=False, separators=(",", ":")) + "\n"
    if len(idx.encode()) > CAP_INDEX:
        raise Fail(f"index is {len(idx.encode())} B, over {CAP_INDEX}: shorten 'when' lines")
    files["index.json"] = idx
    return files


def on_disk(root):
    base, out = os.path.join(root, "packs"), {}
    for d, _, names in os.walk(base):
        for n in names:
            rel = os.path.relpath(os.path.join(d, n), base)
            if rel != "topics.json":
                with open(os.path.join(d, n), encoding="utf-8") as fh:
                    out[rel] = fh.read()
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=os.path.realpath(os.path.join(os.path.dirname(__file__), "..")))
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    try:
        want = build(a.root)
    except (Fail, OSError) as e:
        print(f"topic-packs: {e}", file=sys.stderr)
        return 1
    have = on_disk(a.root)
    if a.check:
        drift = sorted(set(want) ^ set(have)) + sorted(k for k in want if k in have and want[k] != have[k])
        for k in drift:
            print(f"topic-packs: DRIFT packs/{k}", file=sys.stderr)
        if drift:
            print("topic-packs: packs/ is not what packs/topics.json builds; run bin/topic-packs", file=sys.stderr)
            return 1
        print(f"topic-packs: {len(want)} files match the manifest")
        return 0
    base = os.path.join(a.root, "packs")
    for k in set(have) - set(want):
        os.remove(os.path.join(base, k))
    for k, v in want.items():
        p = os.path.join(base, k)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as fh:
            fh.write(v)
    print(f"topic-packs: wrote {len(want)} files")
    return 0


if __name__ == "__main__":
    sys.exit(main())
