#!/usr/bin/env python3
"""provenance-check — refuse commits that lie about who wrote them, and files that run themselves.

  provenance-check [--allowed-signers FILE] [--allow-paths FILE] [RANGE]

RANGE is any range `git rev-list` accepts; the default is `origin/main..HEAD`. Every commit in it is
checked, merges included, and each file a commit adds or changes is read from that commit's own
blob, so a payload added and then removed inside the range is still seen.

Rows (each one independently, so a finding always says which row refused it):

  1 signature        REFUSE  a commit not signed by a key on the allow-list (unsigned, a bad
                             signature, an unlisted key, or one git cannot verify). Listed means
                             the signing key's fingerprint is in the file, whatever the signature
                             type: a GPG or X.509 key the runner happens to trust is not listed.
  2 author-signer    REFUSE  the signing key is listed, but not for the commit's author email; or
                             the author email IS listed and the commit carries no listed signature
                             (a known identity worn by someone else, or by no one)
  3 copied-identity  WARN    a non-merge commit whose author date and full message equal another
                             commit's, with a DIFFERENT patch. A rebase or cherry-pick keeps the
                             date and message too, so this alone is not proof; it is printed, and
                             never fails the run. An identical patch (patch-id) is not reported.
                             In a shallow clone the other commits are missing, so the row prints
                             SKIP and says so instead of reporting nothing.
  4 autorun-on-open  REFUSE  an editor or container file that runs a command when the repository is
                             opened: a VS Code task with `runOn: folderOpen`; a settings or
                             workspace file turning `task.allowAutomaticTasks` on; a dev container
                             lifecycle command (initialize/onCreate/updateContent/postCreate/
                             postStart/postAttach); a committed `.githooks/` file; an added line
                             that sets git's hooks path, by `git config`, `-c`, a config file or
                             the GIT_CONFIG_KEY_<n> / GIT_CONFIG_PARAMETERS environment (to
                             anything but exactly /dev/null), or any other added line that names
                             core.hooksPath (a backslash continuation, a variable); a symlink or a
                             submodule at any of those paths or named .vscode/.devcontainer/
                             .githooks. Paths match in any case. The
                             editor and container files are PARSED as JSON with comments (escapes,
                             comments, trailing commas and repeated keys all read as the editor
                             reads them) and one that does not parse is refused. Added lines are
                             read with `--text`, so a `.gitattributes` marking files binary cannot
                             hide them
  5 type-mismatch    REFUSE  a font, image or archive extension whose bytes do not start with that
                             format's magic number (a Git LFS pointer is accepted)
  6 obfuscation      REFUSE  a NEW single-line .js/.mjs/.cjs file over 10 KB, or any changed text
                             file with the string-array-rotation shape (an array rotated by
                             push(shift()) plus hex-named identifiers or a large string array). A
                             NUL byte exempts other files as binary, never a .js/.mjs/.cjs file

--allowed-signers FILE  git's `allowed_signers` format (`principals [options] keytype key`), the
                        file `gpg.ssh.allowedSignersFile` takes. Principals may be patterns
                        (`*@example.com`), so a forge's web-merge key can be listed for every
                        human it signs for, and an agent's delegated key for the human it acts as.
                        SSH KEYS ONLY: a key is matched by its SSH `SHA256:` fingerprint, so a
                        GPG- or X.509-signed commit (a forge web-merge signed with GPG, say) is
                        always refused by row 1. Keys are listed directly; a `cert-authority` line
                        does not list the keys it certifies. Without it, rows 1-2 are NOT CHECKED and the exit code says
                        so (3).
--allow-paths FILE      one `<glob> <reason>` per line (`#` comments). A matching path is exempt
                        from rows 4-6. A line with no reason is an error: an exemption nobody can
                        explain is a hole.
--base REF              where a list file INSIDE the repository is read from. Default: the left
                        side of RANGE (`A` in `A..B` or `A...B`). A list inside the checkout is
                        always read from this ref, never from the working tree, because the change
                        under review could otherwise add its own key or its own exemption. A list
                        outside the checkout is read from disk. A list missing on the base, or a
                        range with no left side and no --base, cannot run (2).

Output names the commit, the path and the reason, never file contents or commit messages. Paths and
emails are escaped to printable ASCII, so an attacker-chosen file name cannot write its own log line.

Exit: 0 clean (warnings allowed) · 1 at least one REFUSE · 2 cannot run (bad range, an empty range,
git or ssh-keygen missing, an unreadable allow-list, output git produced that does not parse, any
internal error) · 3 nothing refused, but rows 1-2 were not
checked because no allow-list was given — a scan that could not look is never reported clean.
"""
from __future__ import annotations

import argparse
import json
import base64
import fnmatch
import hashlib
import os
import re
import shlex
import codecs
import shutil
import subprocess
import sys
import tempfile

ZERO = "0" * 40
SHA = re.compile(r"\A(?:[0-9a-f]{40}|[0-9a-f]{64})\Z")

# An allowed_signers key type: ssh-ed25519, ecdsa-sha2-nistp256, the sk- security-key types, and
# their certificate forms. Matched by prefix, after the principals field, so options never match.
KEYTYPE = re.compile(r"^(ssh|ecdsa|sk)-[a-z0-9-]+")
SIG_REASON = {
    "N": "unsigned",
    "B": "bad signature",
    "U": "signed by a key that is not on the allow-list",
    "E": "signature cannot be checked (missing key or tool)",
    "X": "signature has expired",
    "Y": "signed by an expired key",
    "R": "signed by a revoked key",
}

# Row 5: extension -> [(offset, magic), ...]; any one match is a pass.
MAGIC = {
    ".woff": [(0, b"wOFF")], ".woff2": [(0, b"wOF2")],
    ".ttf": [(0, b"\x00\x01\x00\x00"), (0, b"true"), (0, b"ttcf")],
    ".otf": [(0, b"OTTO")], ".ttc": [(0, b"ttcf")], ".eot": [(34, b"LP")],
    ".png": [(0, b"\x89PNG\r\n\x1a\n")], ".jpg": [(0, b"\xff\xd8\xff")],
    ".jpeg": [(0, b"\xff\xd8\xff")], ".gif": [(0, b"GIF87a"), (0, b"GIF89a")],
    ".ico": [(0, b"\x00\x00\x01\x00")], ".cur": [(0, b"\x00\x00\x02\x00")],
    ".bmp": [(0, b"BM")], ".webp": [(8, b"WEBP")], ".avif": [(4, b"ftyp")],
    ".tif": [(0, b"II*\x00"), (0, b"MM\x00*")], ".tiff": [(0, b"II*\x00"), (0, b"MM\x00*")],
    ".zip": [(0, b"PK\x03\x04"), (0, b"PK\x05\x06"), (0, b"PK\x07\x08")],
    ".jar": [(0, b"PK\x03\x04")], ".whl": [(0, b"PK\x03\x04")], ".apk": [(0, b"PK\x03\x04")],
    ".gz": [(0, b"\x1f\x8b")], ".tgz": [(0, b"\x1f\x8b")], ".bz2": [(0, b"BZh")],
    ".xz": [(0, b"\xfd7zXZ\x00")], ".7z": [(0, b"7z\xbc\xaf\x27\x1c")],
    ".rar": [(0, b"Rar!\x1a\x07")], ".tar": [(257, b"ustar")], ".pdf": [(0, b"%PDF-")],
}
LFS_POINTER = re.compile(rb"\Aversion https://git-lfs\.github\.com/spec/v1\n"
                         rb"oid sha256:[0-9a-f]{64}\nsize \d+\n\Z")

# Row 4
DEVCONTAINER_KEYS = ("initializeCommand", "onCreateCommand", "updateContentCommand",
                     "postCreateCommand", "postStartCommand", "postAttachCommand")
HOOKS_PATH = [
    re.compile(r"(?i)\bconfig\b.*\bcore\.hookspath\b"),  # the git CLI setting it
    re.compile(r"(?i)\bcore\.hookspath\s*="),            # a one-off -c override
    re.compile(r"(?i)^\s*hookspath\s*="),                # the key inside a config file
    re.compile(r"(?i)\bgit_config_key_\d+\W{1,6}core\.hookspath\b"),  # GIT_CONFIG_KEY_<n>=core.hooksPath
    re.compile(r"(?i)\bgit_config_parameters\b.*\bcore\.hookspath\b"),  # GIT_CONFIG_PARAMETERS
]
# Pointing the hooks path at exactly /dev/null turns hooks OFF (a test or a clean clone does this);
# that is the opposite of the threat, so it is not refused. Each such setting is cut out of the line
# and the rest is checked again: one /dev/null setting never excuses another setting beside it.
HOOKS_OFF = re.compile(r"""(?i)hookspath['"]?\s*[=,]?\s*['"]?/dev/null(?=['"]?(?:\s|$|[;,)&|]))""")
# Row 4 paths that an editor or git reads: a symlink at one, or named like one of these folders,
# could point the editor at a file this check never reads, so it is refused outright.
WATCHED_DIRS = (".vscode", ".devcontainer", ".githooks")
GITLINK = "160000"
LINK_MODES = {
    "120000": "a symlink at an editor, container or hook path: it can point the editor at a file "
              "this check does not read",
    GITLINK: "a submodule at an editor, container or hook path: a recursive clone fills it with "
             "files this check does not read",
}
# The patterns above read one line at a time, so a `\` continuation or a variable holding the key
# (`K=core.hooksPath; ... KEY_0=$K`) splits the setting across them. Any added line still naming
# the key, once its exact /dev/null settings are cut out, is refused.
NAMES_HOOKS_PATH = re.compile(r"(?i)core\.hookspath")

# Row 6
ROTATE = re.compile(r"""\[\s*['"]push['"]\s*\]\s*\(\s*[\w$]+\s*\[\s*['"]shift['"]\s*\]\s*\(\s*\)\s*\)"""
                    r"""|\.push\(\s*[\w$]+\.shift\(\s*\)\s*\)""")
HEX_IDENT = re.compile(r"\b_0x[0-9a-fA-F]{3,}\b")
STR_ARRAY = re.compile(r"""\[\s*(?:'[^'\n]*'|"[^"\n]*")(?:\s*,\s*(?:'[^'\n]*'|"[^"\n]*")){19,}\s*,?\s*\]""")
JS_EXT = (".js", ".mjs", ".cjs")
SINGLE_LINE_LIMIT = 10 * 1024


class CannotRun(Exception):
    pass


def safe(s):
    """Printable ASCII only: a path or email is attacker-chosen and must not shape the log."""
    if isinstance(s, bytes):
        s = s.decode("utf-8", "backslashreplace")
    return "".join(c if " " <= c <= "~" else "\\x%02x" % ord(c) if ord(c) < 256 else "\\u%04x" % ord(c)
                   for c in s)


def git(*args, raw=False, check=True, env=None):
    try:
        p = subprocess.run(["git", "-c", "core.quotePath=false", *args],
                           capture_output=True, env=env)
    except FileNotFoundError:
        raise CannotRun("git is not installed")
    if check and p.returncode != 0:
        raise CannotRun("git %s failed: %s" % (args[0], safe(p.stderr.strip()[:300])))
    return p.stdout if raw else p.stdout.decode("utf-8", "surrogateescape")


# ── allow-lists ──────────────────────────────────────────────────────────────────────────────
def fingerprint(blob_b64):
    digest = hashlib.sha256(base64.b64decode(blob_b64)).digest()
    return "SHA256:" + base64.b64encode(digest).decode().rstrip("=")


def load_signers(path):
    """fingerprint -> [principal pattern, ...], read the way ssh-keygen reads allowed_signers."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError as e:
        raise CannotRun("cannot read the allowed-signers file %s: %s" % (safe(path), e.strerror))
    keys = {}
    for n, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            tok = shlex.split(line)
        except ValueError:
            raise CannotRun("allowed-signers line %d does not parse" % n)
        idx = next((i for i, t in enumerate(tok) if i > 0 and KEYTYPE.match(t)), None)
        if idx is None or idx + 1 >= len(tok):
            raise CannotRun("allowed-signers line %d has no principals, key type and key" % n)
        try:
            fp = fingerprint(tok[idx + 1])
        except (ValueError, TypeError):
            raise CannotRun("allowed-signers line %d: the key is not base64" % n)
        keys.setdefault(fp, []).extend(p for p in tok[0].split(",") if p)
    if not keys:
        raise CannotRun("the allowed-signers file %s lists no keys" % safe(path))
    return keys


def principal_matches(email, patterns):
    """ssh pattern-list semantics: any positive match, and no negated (`!`) match."""
    email = email.lower()
    hit = False
    for p in patterns:
        neg = p.startswith("!")
        if fnmatch.fnmatchcase(email, (p[1:] if neg else p).lower()):
            if neg:
                return False
            hit = True
    return hit


def load_allow_paths(path):
    if not path:
        return []
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError as e:
        raise CannotRun("cannot read the path allow-list %s: %s" % (safe(path), e.strerror))
    out = []
    for n, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        if len(parts) < 2 or not parts[1].strip():
            raise CannotRun("path allow-list line %d has no reason; every exemption states why" % n)
        out.append(parts[0])
    return out


# ── reading the range ────────────────────────────────────────────────────────────────────────
def commits_in(rng, signers_file):
    cfg = ["-c", "gpg.ssh.allowedSignersFile=" + signers_file] if signers_file else []
    fields = ["%H", "%P", "%G?", "%GF", "%GS", "%ae", "%ad"]
    out = git(*cfg, "log", "-z", "--format=" + "%x00".join(fields), "--date=raw", rng)
    commits = []
    for h, parents, sig, fp, principal, email, date in nul_records(out, len(fields)):
        commits.append({"sha": h, "parents": parents.split(), "sig": sig, "fp": fp,
                        "principal": principal, "email": email, "date": date})
    return commits


def nul_records(out, width):
    """`git log -z` output whose fields are also NUL-separated, as tuples of `width` fields. Any byte
    may sit in a message or an email except NUL, so nothing a commit carries can shift a field; a
    record that still does not line up (a crafted object) stops the run instead of being guessed."""
    if not out:
        return []
    parts = out.split("\0")
    if len(parts) % width == 1 and parts[-1] == "":
        parts.pop()
    recs = [parts[i:i + width] for i in range(0, len(parts), width)]
    if len(parts) % width or any(not SHA.match(r[0].lstrip("\n")) for r in recs):
        raise CannotRun("git log output does not parse into %d-field records" % width)
    return [tuple([r[0].lstrip("\n")] + r[1:]) for r in recs]


def changed_blobs(c):
    """[(status, path, blob sha, mode)] the commit adds or changes; for a merge, only what differs from
    EVERY parent (content the merge itself introduced). Deletions are skipped; a submodule (mode
    160000) is kept, because row 4 refuses one at a watched path, and its sha is a commit, not a
    blob, so every row that reads content skips it."""
    args = ["diff-tree", "-r", "-z", "--raw", "--no-renames", "--no-commit-id", "--root"]
    if len(c["parents"]) > 1:
        args.append("-c")
    out = git(*args, c["sha"])
    parts = out.split("\0")
    res = []
    i = 0
    while i < len(parts) - 1:
        meta, path = parts[i], parts[i + 1]
        i += 2
        if not meta.startswith(":"):
            continue
        fields = meta.lstrip(":").split()
        n = (len(fields) - 1) // 2  # modes and shas, one each per parent plus one for the result
        modes, shas, status = fields[:n], fields[n:2 * n], fields[-1]
        if shas[-1] == ZERO or "D" in status:
            continue
        res.append(("A" if set(status) == {"A"} else "M", path, shas[-1], modes[-1]))
    return res


def blob(sha):
    return git("cat-file", "blob", sha, raw=True)


def unquote_path(s):
    """A diff header path, C-quoted by git when it holds an odd byte."""
    if len(s) >= 2 and s[0] == s[-1] == '"':
        s = codecs.escape_decode(s[1:-1].encode("utf-8", "surrogateescape"))[0].decode(
            "utf-8", "surrogateescape")
    return s[2:] if s.startswith("b/") else s


def added_lines(c):
    """[(path, line)] of lines the commit adds (combined diff for a merge). `--text` diffs every
    file as text: the commit under review may itself carry a `.gitattributes` marking files `-diff`.
    The path comes only from a file header (a `diff ` line up to its first `@@`); inside a hunk
    every line is content, even one that reads like a header."""
    out = git("show", "--text", "--format=", "-U0", "--no-color", "--no-ext-diff", "--no-textconv",
              "--no-renames", c["sha"])
    width = max(1, len(c["parents"]))
    path, in_header, res = None, False, []
    for line in out.split("\n"):  # never splitlines(): it also splits on \x1c-\x1e, \x85, \u2028
        if line.startswith("diff "):
            path, in_header = None, True
            continue
        if in_header:
            if line.startswith("+++ "):
                target = line[4:]
                path = None if target == "/dev/null" else unquote_path(target)
            elif line.startswith("@@"):
                in_header = False
            continue
        if path is None or line.startswith("@@"):
            continue
        prefix = line[:width]
        if "+" in prefix and "-" not in prefix and len(line) >= width:
            res.append((path, line[width:]))
    return res


def patch_id(sha):
    diff = git("show", "--text", "--format=", "--no-color", "--no-ext-diff", sha, raw=True)
    try:
        p = subprocess.run(["git", "patch-id", "--stable"], input=diff, capture_output=True)
    except FileNotFoundError:
        raise CannotRun("git is not installed")
    out = p.stdout.decode().split()
    return out[0] if out else ""


# ── rows ─────────────────────────────────────────────────────────────────────────────────────
def is_listed(c, keys):
    """A good signature by a key whose fingerprint the allow-list names. `G` alone is not enough: git
    also reports `G` for a GPG or X.509 key the runner's own keyring trusts."""
    return c["sig"] == "G" and c["fp"] in keys


def row_signature(ctx):
    found = []
    for c in ctx["commits"]:
        if c["sig"] == "G" and not is_listed(c, ctx["signers"]):
            found.append((c["sha"], None, "signed by a key whose fingerprint is not on the allow-list"))
        elif c["sig"] != "G":
            found.append((c["sha"], None, SIG_REASON.get(c["sig"], "signature status %s" % c["sig"])))
    return found


def row_author_signer(ctx):
    found = []
    keys = ctx["signers"]
    known = [p for ps in keys.values() for p in ps]
    for c in ctx["commits"]:
        email = c["email"]
        if is_listed(c, keys):
            patterns = keys[c["fp"]]
            if not principal_matches(email, patterns):
                found.append((c["sha"], None, "author %s, but the signing key is listed for %s, "
                              "not for that author" % (safe(email), safe(",".join(patterns)))))
        elif principal_matches(email, known):
            found.append((c["sha"], None, "author %s is on the allow-list, but the commit carries "
                          "no listed signature (%s)" % (safe(email), SIG_REASON.get(c["sig"], c["sig"]))))
    return found


def row_copied_identity(ctx):
    found = []
    index = ctx["identity_index"]
    for c in ctx["commits"]:
        if len(c["parents"]) > 1:
            continue
        twins = [h for h in index.get(ctx["identity"][c["sha"]], []) if h != c["sha"]]
        if not twins:
            continue
        mine = patch_id(c["sha"])
        for t in twins:
            if patch_id(t) != mine:
                found.append((c["sha"], None, "author date and message equal those of %s, but the "
                              "change differs" % t[:12]))
                break
    return found


def path_key(path):
    """The form a path is matched in. Case-folded: on a case-insensitive file system (the default on
    macOS and Windows) `.VSCode/Tasks.json` IS the file the editor runs."""
    return path.lower()


class Members(list):
    """A JSON object as its [(key, value), ...] in order. A repeated key keeps EVERY value, so a
    benign last copy cannot hide the first one from this check."""


def strip_jsonc(text):
    """JSON-with-comments to JSON, the way VS Code reads these files: `//` and `/* */` comments
    become whitespace and a trailing comma before `}` or `]` is dropped, never inside a string."""
    out, i, n, comma = [], 0, len(text), None
    while i < n:
        ch = text[i]
        if ch == '"':
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            out.append(text[i:j + 1])
            comma, i = None, j + 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            if j < 0:
                raise ValueError("an unterminated comment")
            out.append(" ")
            i = j + 2
        else:
            if ch in "}]" and comma is not None:
                out[comma] = " "  # a trailing comma
            if ch == ",":
                comma = len(out)
            elif not ch.isspace():
                comma = None
            out.append(ch)
            i += 1
    return "".join(out)


def load_jsonc(data):
    """The parsed file, objects as Members; None for an empty file. Raises ValueError when it does
    not parse."""
    text = strip_jsonc(data.decode("utf-8", "replace").lstrip("\ufeff"))
    if not text.strip():
        return None
    return json.loads(text, object_pairs_hook=Members)


def members(node):
    """Every (key, value) of every object in the tree, at any depth."""
    if isinstance(node, dict):
        node = Members(node.items())
    if isinstance(node, Members):
        for k, v in node:
            yield k, v
            yield from members(v)
    elif isinstance(node, list):
        for v in node:
            yield from members(v)


def _autorun_reason(path, data):
    path = path_key(path)
    base = path.rsplit("/", 1)[-1]
    parent = path.rsplit("/", 2)[-2] if path.count("/") else ""
    reasons = []
    workspace = base.endswith(".code-workspace")
    tasks = (base == "tasks.json" and parent == ".vscode") or workspace
    settings = (base == "settings.json" and parent == ".vscode") or workspace
    container = base == ".devcontainer.json" or ("/.devcontainer/" in "/" + path and base.endswith(".json"))
    if tasks or settings or container:
        try:
            tree = load_jsonc(data)
        except (ValueError, RecursionError):
            return ["the file does not parse as JSON with comments, so it cannot be checked "
                    "(an editor may still run what it holds)"]
        found = list(members(tree))
        if tasks and any(k == "runOn" and str(v).lower() == "folderopen" for k, v in found):
            reasons.append("a task runs when the folder is opened (runOn: folderOpen)")
        auto = [v for k, v in found if k == "task.allowAutomaticTasks"]
        auto += [v2 for k, v in found if k == "task" for k2, v2 in members(v) if k2 == "allowAutomaticTasks"]
        if settings and any(v not in ("off", False) for v in auto):
            reasons.append("task.allowAutomaticTasks is turned on")
        keys = [k for k in DEVCONTAINER_KEYS if any(k2 == k for k2, _v in found)]
        if container and keys:
            reasons.append("a dev container runs %s" % "/".join(keys))
    if "/.githooks/" in "/" + path:
        reasons.append("a committed git hook (.githooks/)")
    return reasons


def row_autorun(ctx):
    found = []
    for c in ctx["commits"]:
        for _status, path, sha, mode in ctx["blobs"][c["sha"]]:
            if ctx["exempt"](path):
                continue
            key = path_key(path)
            base = key.rsplit("/", 1)[-1]
            watched = (base in ("tasks.json", "settings.json", ".devcontainer.json")
                       or base.endswith(".code-workspace") or "/.devcontainer/" in "/" + key
                       or "/.githooks/" in "/" + key)
            if mode in LINK_MODES and (watched or base in WATCHED_DIRS):
                found.append((c["sha"], path, LINK_MODES[mode]))
                continue
            if not watched or mode == GITLINK:
                continue
            for r in _autorun_reason(path, blob(sha)):
                found.append((c["sha"], path, r))
        seen = set()
        for path, line in ctx["added"](c):
            if path in seen or ctx["exempt"](path):
                continue
            rest = HOOKS_OFF.sub("", line)
            if any(p.search(rest) for p in HOOKS_PATH) or NAMES_HOOKS_PATH.search(rest):
                seen.add(path)
                found.append((c["sha"], path, "an added line sets git's hooks path (core.hooksPath)"))
    return found


def row_type_mismatch(ctx):
    found = []
    for c in ctx["commits"]:
        for _status, path, sha, mode in ctx["blobs"][c["sha"]]:
            ext = os.path.splitext(path)[1].lower()
            if ext not in MAGIC or ctx["exempt"](path) or mode == GITLINK:
                continue
            data = blob(sha)
            if not data or LFS_POINTER.match(data):
                continue
            if any(data[off:off + len(m)] == m for off, m in MAGIC[ext]):
                continue
            head = data[:1024]
            texty = b"\0" not in head and sum(9 <= b <= 13 or 32 <= b <= 126 for b in head) > 0.9 * len(head)
            found.append((c["sha"], path, "a %s file whose bytes are not %s%s" % (
                ext, ext[1:].upper(), " (they are text or script)" if texty else "")))
    return found


def row_obfuscation(ctx):
    found = []
    for c in ctx["commits"]:
        for status, path, sha, mode in ctx["blobs"][c["sha"]]:
            if ctx["exempt"](path) or mode == GITLINK:
                continue
            data = blob(sha)
            if b"\0" in data[:8192] and not path.lower().endswith(JS_EXT):
                continue  # binary; a script never is, so a NUL cannot exempt one
            if (status == "A" and path.lower().endswith(JS_EXT) and len(data) > SINGLE_LINE_LIMIT
                    and b"\n" not in data.rstrip(b"\r\n")):
                found.append((c["sha"], path, "a new %d-byte JavaScript file on a single line" % len(data)))
                continue
            text = data.decode("utf-8", "replace")
            if ROTATE.search(text) and (len(HEX_IDENT.findall(text)) >= 5 or STR_ARRAY.search(text)):
                found.append((c["sha"], path, "the string-array-rotation shape of an obfuscator"))
    return found


ROWS = [
    ("signature", "REFUSE", row_signature, True),
    ("author-signer", "REFUSE", row_author_signer, True),
    ("copied-identity", "WARN", row_copied_identity, False),
    ("autorun-on-open", "REFUSE", row_autorun, False),
    ("type-mismatch", "REFUSE", row_type_mismatch, False),
    ("obfuscation", "REFUSE", row_obfuscation, False),
]


def build_context(rng, signers_file, allow_globs):
    commits = commits_in(rng, signers_file)
    if not commits:
        raise CannotRun("0 commits in %s; nothing was checked, which is not a pass (a shallow or "
                        "missing fetch produces exactly this)" % safe(rng))
    shallow = git("rev-parse", "--is-shallow-repository").strip() == "true"
    ident_fmt = "%x00".join(["%H", "%ad", "%B"])
    index, identity = {}, {}
    if not shallow:  # row 3 is skipped, and says so, in a shallow clone
        for h, date, msg in nul_records(git("log", "-z", "--all", "--no-merges", "--date=raw",
                                            "--format=" + ident_fmt), 3):
            index.setdefault((date, msg), []).append(h)
            identity[h] = (date, msg)
        for c in commits:  # a range commit not reachable from any ref (a bare sha) still needs a key
            if c["sha"] not in identity and len(c["parents"]) <= 1:
                for h, date, msg in nul_records(git("log", "-z", "-1", "--date=raw",
                                                    "--format=" + ident_fmt, c["sha"]), 3):
                    identity[c["sha"]] = (date, msg)
                    index.setdefault((date, msg), []).append(c["sha"])
    cache = {}

    def added(c):
        if c["sha"] not in cache:
            cache[c["sha"]] = added_lines(c)
        return cache[c["sha"]]

    return {
        "commits": commits,
        "signers": load_signers(signers_file) if signers_file else {},
        "blobs": {c["sha"]: changed_blobs(c) for c in commits},
        "identity_index": index,
        "identity": identity,
        "shallow": shallow,
        "added": added,
        "exempt": lambda p: any(fnmatch.fnmatchcase(p, g) for g in allow_globs),
    }


def skip_reason(name, ctx):
    """Why a row cannot look at this checkout, or None. A row that cannot look says so; it never
    reports nothing, which would read as nothing found."""
    if name == "copied-identity" and ctx["shallow"]:
        return ("the clone is shallow, so the commits a copy would be taken from are not here; "
                "fetch the full history (fetch-depth: 0) to check this row")
    return None


def range_base(rng):
    """`A` in `A..B` or `A...B` (HEAD when A is empty); None for any other range form."""
    for sep in ("...", ".."):
        if sep in rng:
            return rng.split(sep, 1)[0] or "HEAD"
    return None


def list_source(path, base, tmp):
    """The file to read a list from. A list inside the checkout is read from `base`, never from the
    working tree: the change under review could otherwise list its own key or its own exemption.
    A list outside the checkout (a runner path, a CI secret file) is read where it is."""
    top = git("rev-parse", "--show-toplevel", check=False).strip()
    if not top:
        return path
    top = os.path.realpath(top)
    ab = os.path.abspath(path)
    rels = [os.path.relpath(p, top) for p in
            (os.path.join(os.path.realpath(os.path.dirname(ab)), os.path.basename(ab)),
             os.path.realpath(ab))]
    inside = [r for r in rels if r != ".." and not r.startswith(".." + os.sep)]
    if not inside:
        return path
    rel = inside[0].replace(os.sep, "/")
    if base is None:
        raise CannotRun("the list %s is inside the repository; give --base REF (or an A..B range) so "
                        "it is read from the base, not from the change under review" % safe(path))
    obj = "%s:%s" % (base, rel)
    if subprocess.run(["git", "-C", top, "cat-file", "-e", obj], capture_output=True).returncode:
        raise CannotRun("the list %s is not on the base %s; a list the change adds cannot vouch "
                        "for the change" % (safe(rel), safe(base)))
    data = git("-C", top, "cat-file", "blob", obj, raw=True)
    out = os.path.join(tmp, "%d-%s" % (len(os.listdir(tmp)), os.path.basename(rel)))
    with open(out, "wb") as f:
        f.write(data)
    print("provenance-check: %s read from %s:%s" % (safe(path), safe(base), safe(rel)))
    return out


def main(argv):
    ap = argparse.ArgumentParser(prog="provenance-check", add_help=True,
                                 description="Refuse forged commits and files that run themselves.")
    ap.add_argument("range", nargs="?", default="origin/main..HEAD")
    ap.add_argument("--allowed-signers", metavar="FILE")
    ap.add_argument("--allow-paths", metavar="FILE")
    ap.add_argument("--base", metavar="REF")
    a = ap.parse_args(argv)
    tmp = tempfile.mkdtemp(prefix="provenance-check-")
    try:
        return run(a, tmp)
    except CannotRun as e:
        print("provenance-check: cannot run: %s" % e, file=sys.stderr)
        return 2
    except Exception as e:  # an unexpected crash must never exit 1, which reads as "refused"
        print("provenance-check: cannot run: internal error (%s)" % type(e).__name__, file=sys.stderr)
        return 2
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def run(a, tmp):
    if a.allowed_signers and not shutil.which("ssh-keygen"):
        raise CannotRun("ssh-keygen is not installed; SSH signatures cannot be verified")
    base = a.base or range_base(a.range)
    signers_file = (os.path.abspath(list_source(a.allowed_signers, base, tmp))
                    if a.allowed_signers else None)
    allow_file = list_source(a.allow_paths, base, tmp) if a.allow_paths else None
    if signers_file:
        load_signers(signers_file)  # fail early on an unreadable or empty list
    ctx = build_context(a.range, signers_file, load_allow_paths(allow_file))
    refused = warned = 0
    for name, level, fn, needs_signers in ROWS:
        if needs_signers and not signers_file:
            continue
        why_not = skip_reason(name, ctx)
        if why_not:
            print("%-7s %-16s %s" % ("SKIP", name, why_not))
            continue
        for sha, path, why in fn(ctx):
            where = sha[:12] + ("  " + safe(path) if path else "")
            print("%-7s %-16s %s: %s" % (level, name, where, why))
            if level == "REFUSE":
                refused += 1
            else:
                warned += 1
    n = len(ctx["commits"])
    print("provenance-check: %d commit(s) in %s · %d refused · %d warning(s)" % (n, safe(a.range), refused, warned))
    if refused:
        return 1
    if not signers_file:
        print("provenance-check: rows signature and author-signer NOT CHECKED (no --allowed-signers)")
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
