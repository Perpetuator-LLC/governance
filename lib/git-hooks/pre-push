#!/usr/bin/env bash
# governance hygiene pre-push — refuse a push while this repository is over its branch, worktree or
# stale-branch budget (bin/hygiene-check in the governance core says what each budget counts).
#
# Installed into the repository's git hooks directory by `governance scaffold` and by
# `hygiene-check --install-hook`; a hook nobody installs is no gate. The line above is the marker
# --install-hook uses to recognise (and update) its own copy and to refuse to replace anyone else's.
#
# A push that only DELETES refs, or only writes refs/archive/*, passes untouched: that is the cleanup
# push, and the gate must never refuse the work that brings a repository back under budget.
#
# The checker is found as: $HYGIENE_CHECK, `hygiene-check` on PATH, ~/.claude/bin/hygiene-check (where
# `governance install` links the core's bin/), then this repository's own bin/hygiene-check. Not found
# is a refusal by name, never a silent pass.
set -uo pipefail
zero=0000000000000000000000000000000000000000
cleanup=1; lines=0
while read -r lref lsha rref rsha; do
  [ -n "${lref:-}" ] || continue
  lines=$((lines + 1))
  case "$lsha" in *[!0]*) ;; *) continue ;; esac            # a delete: all-zero local sha
  case "$rref" in refs/archive/*) continue ;; esac
  cleanup=0
done
[ "$lines" -gt 0 ] && [ "$cleanup" = 1 ] && exit 0

top="$(git rev-parse --show-toplevel 2>/dev/null)"
for c in "${HYGIENE_CHECK:-}" "$(command -v hygiene-check 2>/dev/null)" "$HOME/.claude/bin/hygiene-check" "$top/bin/hygiene-check"; do
  [ -n "$c" ] && [ -x "$c" ] && exec "$c" --repo "${top:-.}"
done
echo "pre-push: hygiene-check not found (set HYGIENE_CHECK, or put the governance core's bin/ on PATH) — refusing the push" >&2
exit 1
